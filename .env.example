# Telegram Bot Secrets
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your_secret_webhook_token_here

# AI Model Provider
# Options: gemini | puter | openai | groq
AI_PROVIDER=gemini
# Google AI Studio API key: https://aistudio.google.com/apikey
AI_API_KEY=your_google_ai_studio_key_here
AI_MODEL_NAME=gemini-2.5-flash

# Mem0 Long-Term Memory API
MEM0_API_KEY=your_mem0_api_key_here
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# Media Storage
# Options: telegram_cache | r2 | cdn
MEDIA_STORAGE_TYPE=telegram_cache
MEDIA_BASE_URL=https://assets.lunalik.workers.dev/images

# Security & Limits
ENVIRONMENT=production
ADMIN_USER_IDS=123456789,987654321
RATE_LIMIT_PER_MINUTE=20
