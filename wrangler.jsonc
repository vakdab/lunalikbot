{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunalikbot",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "AI_PROVIDER": "groq",
    "AI_MODEL_NAME": "openai/gpt-oss-120b",
    "MEDIA_STORAGE_TYPE": "telegram_cache",
    "RATE_LIMIT_PER_MINUTE": 30
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RouletteHubDO"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "RouletteHubDO"
      ]
    }
  ]
}
