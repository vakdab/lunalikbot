{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunalikbot",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AI_PROVIDER": "gemini",
    "AI_MODEL_NAME": "gemini-2.5-flash",
    "MEDIA_STORAGE_TYPE": "telegram_cache",
    "RATE_LIMIT_PER_MINUTE": 30
  },
  "migrations": [
    {
      "tag": "v2",
      "deleted_classes": [
        "RouletteHubDO"
      ]
    }
  ]
}
